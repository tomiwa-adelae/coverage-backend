# Database (Neon). DATABASE_URL is the pooled URL, DIRECT_URL the unpooled one for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ALLOW_SIGNUP=true

# Where the frontend lives (comma-separated for several). Used for CORS and email links.
FRONTEND_URL=http://localhost:3000
# Optional: the URL used in password reset emails. Defaults to the first FRONTEND_URL.
APP_URL=

# Email: set ONE provider plus EMAIL_FROM (an address on a domain verified with it).
# Without these, password reset links are printed in the server log instead of emailed.
RESEND_API_KEY=
MAILJET_API_PUBLIC_KEY=
MAILJET_API_PRIVATE_KEY=
EMAIL_FROM=

# AI (meeting prep, drafted messages, tidied voice notes, card scans, debriefs).
# Sends prospect notes and history to the provider: confirm with compliance first.
# Set one key. Claude (paid, https://platform.claude.com):
ANTHROPIC_API_KEY=
# Or Google Gemini (free tier at https://aistudio.google.com/apikey). On the free
# tier Google may use what you send to improve its products; a paid (billing on)
# key doesn't. Gemini can also transcribe debriefs, so one key covers both.
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (default gemini-3.8-flash); GEMINI_FALLBACK_MODEL, a
# comma list tried when it's overloaded (default gemini-3.6-flash,gemini-3.5-flash-lite);
# and AI_PROVIDER (anthropic or gemini) when both keys are set.
# (anthropic or gemini) when both keys are set.

# Voice debriefs: speech to text. Deepgram is preferred (listens for your
# prospects' names, opts out of model training). OpenAI also works, and with no
# key here GEMINI_API_KEY is used. Audio is
# sent to the provider and never stored; transcripts are deleted after 14 days.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Only needed when several are set: deepgram, openai or gemini.
TRANSCRIBE_PROVIDER=

# Phone notifications. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# SMS through Termii (https://termii.com). Sender ID must be approved by Termii.
TERMII_API_KEY=
TERMII_SENDER_ID=
# "dnd" reaches numbers on Do-Not-Disturb (needs activation on your Termii account); or "generic".
TERMII_CHANNEL=dnd

# Follow-up reminders run every 5 minutes, morning summaries and Monday reports
# every 15, while the server is awake. Hosts that sleep (Render free) need an
# external cron (e.g. cron-job.org) every 5 minutes to POST
# {APP_URL or API URL}/api/jobs/run with header x-cron-secret: <this value>.
CRON_SECRET=

PORT=8000
NODE_ENV=development
