// Coverage — prospect pipeline and follow-up tracker.
// Money is stored in whole naira as BigInt (serialised to Number in API responses).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RM
  ADMIN
}

enum Tier {
  A
  B
  C
}

enum Stage {
  IDENTIFIED
  CONTACTED
  INTERESTED
  FORMS_SENT
  FORMS_RECEIVED
  ACCOUNT_OPENED
  FUNDED
  DECLINED
}

/// Bank products a prospect may want or already hold.
enum Product {
  CURRENT
  SAVINGS
  FIXED_DEPOSIT
  DOMICILIARY
  POS
  LOAN
  PAYROLL
  TRADE
  DIGITAL
}

/// Where a prospect came from, to see which channels convert.
enum Source {
  REFERRAL
  EXISTING_CUSTOMER
  PERSONAL_NETWORK
  WALK_IN
  EVENT
  COLD_OUTREACH
  SOCIAL_MEDIA
  OTHER
}

enum CallOutcome {
  INTERESTED
  CALL_BACK
  NOT_NOW
  NO_ANSWER
  WRONG_NUMBER
  NOT_INTERESTED
}

enum ConsentMethod {
  VERBAL
  WRITTEN
  WHATSAPP
  EMAIL
  FORM
}

enum TeamRole {
  MANAGER
  MEMBER
}

/// Where an end-of-day voice debrief is in its journey.
enum DebriefStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  APPLIED
}

enum ActivityType {
  CALL
  WHATSAPP
  VISIT
  MEETING
  EMAIL
  SMS
  STAGE_CHANGE
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  phone            String?
  jobTitle         String?
  branch           String?
  // Small square JPEG/PNG/WebP as a data URL, resized in the browser before upload
  avatarUrl        String?
  role             Role     @default(RM)
  // Confirmation target in naira
  targetAmount     BigInt   @default(180000000)
  // Start of the measurement window for the target
  targetStartDate  DateTime @default(now()) @db.Date
  // End of the measurement window; null means six months after the start
  targetEndDate    DateTime? @db.Date
  timezone         String   @default("Africa/Lagos")
  // Contacts to log per day; drives the goal ring and streak
  dailyGoal        Int      @default(10)
  // Default message templates are created once, so deleting them sticks
  templatesSeeded  Boolean  @default(false)
  cadencesSeeded   Boolean  @default(false)

  // Morning summary (email and push) at this local hour
  digestEmail      Boolean  @default(true)
  digestPush       Boolean  @default(true)
  digestHour       Int      @default(7)
  lastDigestOn     String?
  // Push reminder this many minutes before a follow-up that has a time
  reminderLead     Int      @default(30)
  // "Debrief your day" push on working days at this local hour; -1 is off
  debriefHour      Int      @default(17)
  lastDebriefNudgeOn String?
  // Weekly report emailed on Monday mornings
  managerEmail     String?
  weeklyReport     Boolean  @default(false)
  lastReportOn     String?

  // Secret token for the read-only calendar feed (.ics)
  calendarToken    String?  @unique

  // TOTP two-step sign-in. Backup codes are stored as SHA-256 hashes.
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  backupCodes      String[]

  teamId           String?
  teamRole         TeamRole?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  team          Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  prospects     Prospect[]
  activities    Activity[]
  templates     Template[]
  tasks         Task[]
  cadences      Cadence[]
  balances      Balance[]
  resetTokens   PasswordResetToken[]
  sessions      Session[]
  pushSubs      PushSubscription[]
  auditLogs     AuditLog[]
  debriefs      Debrief[]
}

/// A signed-in device. The refresh token's SHA-256 is rotated on every refresh.
model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Security-relevant events: sign-ins, password and 2FA changes, exports, deletions.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  detail    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A small group of RMs. Managers see each member's totals, never their prospects.
model Team {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members User[]
}

/// One-time password reset links. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Prospect {
  id            String    @id @default(uuid())
  ownerId       String
  name          String
  company       String?
  group         String?
  phone         String?
  email         String?
  tier          Tier?
  stage         Stage     @default(IDENTIFIED)
  potential     BigInt?
  funded        BigInt?
  nextAction    String?
  nextDate      DateTime? @db.Date
  // Local "HH:MM" on nextDate; set means a timed reminder is sent
  nextTime      String?
  // "YYYY-MM-DD HH:MM" of the follow-up a reminder was last sent for
  remindedFor   String?
  // "How did it go?" push sent after this booked follow-up, same key format
  checkedInFor  String?
  notes         String?
  lastContactAt DateTime?
  // When the prospect entered its current stage, for stale alerts
  stageChangedAt DateTime @default(now())
  // Why they declined, or what won them over
  outcomeReason String?
  source        Source?
  wantsProducts Product[]
  holdsProducts Product[]
  referredById  String?
  // "MM-DD"; the year is rarely known
  birthday      String?
  area          String?
  address       String?
  latitude      Float?
  longitude     Float?
  // Consent to be contacted and to hold their details (NDPA 2023)
  consentAt     DateTime?
  consentMethod ConsentMethod?
  consentNote   String?
  cadenceId     String?
  // Index of the next step to do in the cadence
  cadenceStep   Int?
  cadenceStart  DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  referredBy Prospect?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  Prospect[] @relation("Referrals")
  cadence    Cadence?   @relation(fields: [cadenceId], references: [id], onDelete: SetNull)
  activities Activity[]
  balances   Balance[]
  tasks      Task[]

  @@index([ownerId, nextDate])
  @@index([ownerId, stage])
  @@index([referredById])
}

/// A customer's balance for a month (first day of the month). Drives the real
/// progress figure; the latest one is mirrored to Prospect.funded.
model Balance {
  id         String   @id @default(uuid())
  prospectId String
  userId     String
  month      DateTime @db.Date
  amount     BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([prospectId, month])
  @@index([userId, month])
}

/// A follow-up plan: steps of { day, type, action } counted from the start date.
model Cadence {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  steps     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prospects Prospect[]

  @@index([ownerId])
}

model Activity {
  id         String       @id @default(uuid())
  prospectId String
  userId     String
  type       ActivityType
  outcome    CallOutcome?
  note       String?
  // Only set for STAGE_CHANGE
  fromStage  Stage?
  toStage    Stage?
  occurredAt DateTime     @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([prospectId, occurredAt])
}

/// Reusable outreach message. Body supports {firstName}, {name}, {company} and {myName}.
model Template {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  body      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, position])
}

/// A spoken (or typed) end-of-day debrief: the transcript, the assistant's
/// suggested updates for review, and what was applied. Audio is never stored.
model Debrief {
  id         String        @id @default(uuid())
  userId     String
  status     DebriefStatus @default(UPLOADING)
  // Progress while PROCESSING: TRANSCRIBING or READING
  step       String?
  transcript String?
  // Suggested updates, per person, for the review screen
  result     Json?
  // Per-item outcome after applying
  applied    Json?
  // What saving changed, so it can be undone for a few minutes
  undo       Json?
  appliedAt  DateTime?
  error      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Repeat {
  DAILY
  WEEKLY
  MONTHLY
}

/// A to-do: general, or about one prospect (e.g. a document to collect).
model Task {
  id         String    @id @default(uuid())
  ownerId    String
  prospectId String?
  title      String
  dueDate    DateTime? @db.Date
  // Local "HH:MM" on dueDate; set means a reminder is sent
  dueTime    String?
  // "YYYY-MM-DD HH:MM" a reminder was last sent for
  remindedFor String?
  repeat     Repeat?
  // Set on items of an account-opening checklist: INDIVIDUAL or BUSINESS
  checklist  String?
  position   Int       @default(0)
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([ownerId, doneAt, dueDate])
  @@index([prospectId])
}
